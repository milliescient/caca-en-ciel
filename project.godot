config_version=5

[application]

config/name="caca-en-ciel"
run/main_scene="res://scenes/screen.tscn"
config/icon="res://icon.png"
config/features=PackedStringArray("4.3")
boot_splash/bg_color=Color(0.08, 0.06, 0.12, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
